generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Platform-level role, a tier ABOVE organizations (see auth/roles.ts).
  // Null for every ordinary user; "staff" grants the BOOSTK team access to the
  // global triage inbox across all orgs. Deliberately NOT a Member role: it
  // confers no authority inside any organization.
  platformRole String?

  members        Member[]
  invitations    Invitation[]
  ticketMessages TicketMessage[]
  triagedTickets Ticket[]        @relation("TicketTriagedBy")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String? // try to not use this, use context instead

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String
  logo        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]
  integrations Integration[]

  @@unique([slug])
  @@map("organizations")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedTickets Ticket[]

  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  logo        String?
  slug        String  @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  tickets   Ticket[]

  @@map("projects")
}

model Customer {
  id       String  @id @default(cuid())
  name     String
  email    String
  phone    String?
  metadata String?
  // Detected language of the customer (English name, e.g. "Korean"); agent replies are translated into it.
  language String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        Ticket[]
  ticketMessages TicketMessage[]

  @@map("customers")
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  provider       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Assuming your organization model is named 'Organization'
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // An org should only have one active connection per provider
  @@unique([organizationId, provider])
  @@map("integrations")  
}

model Ticket {
  id              String         @id @default(cuid())
  referenceNumber String         @unique
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(LOW)

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // The org member (role >= agent) responsible for this ticket. Nullable: a
  // ticket starts unassigned and is claimed from the ticket detail panel.
  assignedAgentId String?
  assignedAgent   Member? @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // --- Global intake / triage (see docs/global-chat-triage.md) ---
  //
  // A chat started from the public /chat route lands in the seeded BOOSTK intake
  // project with no organization behind it yet. Triage then creates a NEW ticket
  // in the target project; these fields tie the two halves together.
  //
  // On the ROUTED ticket: points back at the intake conversation it came from.
  intakeTicketId String? @unique
  intakeTicket   Ticket? @relation("TicketIntake", fields: [intakeTicketId], references: [id], onDelete: SetNull)
  // On the INTAKE ticket: the ticket triage created from it.
  routedTicket   Ticket? @relation("TicketIntake")

  // Set on the intake ticket when it is routed. The triage queue is
  // `projectId = <intake> AND status = OPEN`, so no new TicketStatus is needed.
  routedAt    DateTime?
  triagedById String?
  triagedBy   User?     @relation("TicketTriagedBy", fields: [triagedById], references: [id], onDelete: SetNull)
  // Why an intake chat was closed without being routed ("spam" | "no_fit" | "resolved").
  // Null on routed tickets, which record their outcome via `routedTicket` instead.
  triageNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketMessages TicketMessage[]
  messageReads   MessageRead[]
  attachments    Attachment[]

  @@index([assignedAgentId])
  @@index([projectId, status])
  @@index([triagedById])
  @@map("tickets")
}

model TicketMessage {
  id          String                   @id @default(cuid())
  content     String
  contentType TicketMessageContentType @default(TEXT)

  // Cached translation for cross-language support chat (see ticket-message.translation.ts).
  // `content` is what the sender typed; `translatedContent` is the support-language version.
  translatedContent String?
  sourceLang        String?
  targetLang        String?

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Set when contentType is IMAGE or FILE. `content` then holds the attachment URL
  // (see attachment.service.ts) and this relation carries the filename/size/mime
  // needed to render the bubble without parsing the URL.
  attachmentId String?     @unique
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageReads MessageRead[]

  @@map("ticket_messages")
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  ticketId  String
  userId    String
  readAt    DateTime @default(now())

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ticket  Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([ticketId, userId])
  @@map("message_reads")
}

// Uploaded chat file, stored as bytes in Postgres rather than on disk or S3 —
// the database is the only stateful service this app deploys with, so blobs kept
// here survive redeploys with no volume or bucket to configure. Sizes are capped
// hard (see ATTACHMENT_MAX_BYTES) precisely because this row lives in the DB.
//
// Rows are created before the message that references them, so an upload that is
// never sent leaves an orphan — `ticketId` scopes it for access checks and cleanup.
model Attachment {
  id       String @id @default(cuid())
  filename String
  mimeType String
  size     Int
  bytes    Bytes

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message TicketMessage?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("attachments")
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketMessageContentType {
  TEXT
  IMAGE
  FILE
}
