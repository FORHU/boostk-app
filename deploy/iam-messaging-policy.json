{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishRealtimeEvents",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-southeast-1:617163942417:boostk-events"
    },
    {
      "Sid": "WorkBoostkQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:SendMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-southeast-1:617163942417:boostk-*"
    }
  ]
}
