# Template for ~/boostk-app/app.env on the EC2 host.
#
#   scp deploy/app.env.example ec2-user@<host>:~/boostk-app/app.env
#   ssh ec2-user@<host> 'chmod 600 ~/boostk-app/app.env && nano ~/boostk-app/app.env'
#
# NOT named .env deliberately: Docker Compose auto-reads a file called .env in
# the project directory to interpolate ${IMAGE}, and chokes on secrets
# containing $ or unbalanced quotes. Keeping runtime secrets in app.env
# (referenced via env_file:) keeps those two jobs separate.
#
# Never commit the filled-in version — .gitignore already excludes app.env.

# --- database ---------------------------------------------------------------
# Container Postgres: host is the compose service name, not localhost.
POSTGRES_USER=boostk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=boostk
DATABASE_URL=postgresql://boostk:CHANGE_ME@postgres:5432/boostk

# Using RDS instead? Drop the POSTGRES_* lines, delete the postgres service
# from docker-compose.prod.yaml, and use:
# DATABASE_URL=postgresql://boostk:<pw>@<rds-endpoint>:5432/boostk?sslmode=require

# --- auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# MUST be the public origin users actually hit — not localhost, not the private
# IP. Better Auth derives callback URLs and cookie domains from it. Use https://
# once TLS is in place, or sessions will not persist.
BETTER_AUTH_URL=https://your-staging-domain.com

# Comma-separated (src/lib/auth.ts splits on ","). Include every origin that
# embeds the chat widget, or its requests are rejected as cross-origin.
TRUSTED_ORIGINS=https://your-staging-domain.com

# --- messaging --------------------------------------------------------------
RABBITMQ_URL=amqp://rabbitmq:5672
SOCKET_PORT=3001

# --- integrations -----------------------------------------------------------
FORHU_CHAT_URL=CHANGE_ME
SUPPORT_LANGUAGE=en

# --- build-time only, listed for reference ----------------------------------
# VITE_SOCKET_URL and VITE_SUPPORT_PROJECT_ID are compiled into the client
# bundle by GitHub Actions via --build-arg. Setting them here does nothing.
