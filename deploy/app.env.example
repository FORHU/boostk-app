# Template for ~/boostk-app/app.env on the EC2 host.
#
#   scp deploy/app.env.example ec2-user@<host>:~/boostk-app/app.env
#   ssh ec2-user@<host> 'chmod 600 ~/boostk-app/app.env && nano ~/boostk-app/app.env'
#
# NOT named .env deliberately: Docker Compose auto-reads a file called .env in
# the project directory to interpolate ${IMAGE}, and chokes on secrets
# containing $ or unbalanced quotes. Keeping runtime secrets in app.env
# (referenced via env_file:) keeps those two jobs separate.
#
# Never commit the filled-in version — .gitignore already excludes app.env.

# --- database ---------------------------------------------------------------
# Managed Postgres (RDS). The container was removed from docker-compose.prod.yaml,
# so POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB no longer exist — the whole
# connection string is written from the DATABASE_URL GitHub secret instead.
#
# Connect as the app's own role, never the instance's admin user: the RDS is
# shared with another project, and boostk_app can reach only the boostk database.
# `sslmode=require` is not optional off-box — without it the driver will accept an
# unencrypted connection. Percent-encode @ : / ? # % in the password.
# See docs/DATABASE-SETUP.md.
DATABASE_URL=postgresql://boostk_app:CHANGE_ME@<rds-endpoint>:5432/boostk?schema=public&sslmode=require

# --- auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# MUST be the public origin users actually hit — not localhost, not the private
# IP. Better Auth derives callback URLs and cookie domains from it. Use https://
# once TLS is in place, or sessions will not persist.
BETTER_AUTH_URL=https://your-staging-domain.com

# Comma-separated (src/lib/auth.ts splits on ","). Include every origin that
# embeds the chat widget, or its requests are rejected as cross-origin.
#
# Also consumed by the Socket.io relay: this allowlist is the ONLY set of origins
# allowed to open a credentialed realtime connection (socket + SSE). The app origin
# below is required; add every customer site that embeds the widget.
TRUSTED_ORIGINS=https://your-staging-domain.com

# Google sign-in. Optional as a PAIR — leave both blank and the provider is simply not
# registered, so the app still runs on email and password.
#
# The redirect URI to allowlist in Google Cloud Console is derived from BETTER_AUTH_URL:
#   <BETTER_AUTH_URL>/api/auth/callback/google
# Google rejects raw IP addresses and plain http:// for anything but localhost, so this
# only works once BETTER_AUTH_URL is a real https:// domain. See docs/GOOGLE-SSO.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- messaging --------------------------------------------------------------
RABBITMQ_URL=amqp://rabbitmq:5672
SOCKET_PORT=3001

# --- global chat / triage ---------------------------------------------------
# Comma-separated emails granted BOOSTK platform-staff access to /dashboard/triage.
# Read by prisma/seed-intake.ts, which deploy.yml runs after every migration.
# Only promotes users that ALREADY exist — sign up first, then re-run the seeder.
# Leave empty and nobody can see incoming global chats.
PLATFORM_STAFF_EMAILS=you@boostk.com,teammate@boostk.com

# --- integrations -----------------------------------------------------------
FORHU_CHAT_URL=CHANGE_ME
SUPPORT_LANGUAGE=en

# --- build-time only, listed for reference ----------------------------------
# VITE_SOCKET_URL and VITE_SUPPORT_PROJECT_ID are compiled into the client
# bundle by GitHub Actions via --build-arg. Setting them here does nothing.
