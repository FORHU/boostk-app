# Validated at boot by src/env.ts -- a missing or malformed value fails fast
# with a readable listing instead of a stack trace mid-request.

# --- Required in every environment ---
DATABASE_URL=postgresql://localuser:passWord123!@localhost:5432/localdata

# --- Required when NODE_ENV=production (defaulted or optional in dev) ---
BETTER_AUTH_URL=http://localhost:3000/
BETTER_AUTH_SECRET=your_super_secret_random_string_here   # min 16 characters
TRUSTED_ORIGINS=http://localhost:3000                      # comma-separated origin allowlist

# Google sign-in — optional as a PAIR. Leave both blank and the provider is not
# registered, so the app runs on email and password alone.
# Authorized redirect URI in Google Cloud Console, for local dev:
#   http://localhost:3000/api/auth/callback/google
# See docs/GOOGLE-SSO.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RABBITMQ_URL=amqp://username:password@localhost:5672       # defaults to amqp://127.0.0.1:5672 in dev

# SMTP transport for outgoing mail (password reset). Optional as a GROUP in every
# environment: leave HOST / EMAIL / PASSWORD blank and `sendEmail` logs to the server
# console instead, which is what local dev wants. A production deploy with them unset
# still boots, but warns at startup and logs every dropped message as an error --
# password reset is the only account-recovery path, so do not leave it that way.
#
# Gmail: MAILER_PASSWORD must be a 16-character App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), NOT the account password.
MAILER_TRANSPORT_HOST=smtp.gmail.com
MAILER_TRANSPORT_PORT=587                                  # 587 = STARTTLS, 465 = implicit TLS
MAILER_TRANSPORT_SECURE=false                              # true only on port 465
MAILER_EMAIL=you@example.com                               # SMTP username and the From address
MAILER_PASSWORD=

# --- Optional, with defaults ---
NODE_ENV=development                                       # development | production | test
SOCKET_PORT=3001
FORHU_CHAT_URL=https://chat-dev.forhu.ai
SUPPORT_LANGUAGE=en
# Overrides the built-in translation prompt; `{lang}` is the target language name.
# TRANSLATE_SYSTEM_PROMPT=Translate the following into {lang}. Output ONLY the translation, no notes:

# --- Client-side (VITE_ prefix, read via import.meta.env -- NOT validated by src/env.ts) ---
VITE_SOCKET_URL=http://localhost:3001
VITE_SUPPORT_PROJECT_ID=
